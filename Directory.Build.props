<Project>

  <!--
    빌드 산출물을 전부 저장소 루트의 .artifacts/ 로 몬다.

    왜 한곳으로: UPM 패키지는 Runtime/ 폴더를 통째로 유니티에 넘긴다. 그 안에 obj/ 가
    생기면 유니티가 obj/Debug/.../*.AssemblyInfo.cs 를 소스로 인식해 중복 어트리뷰트로
    깨진다. 출력 위치를 옮겨 두면 그 사고가 구조적으로 불가능해진다.

    왜 점으로 시작하나 (2026-08-23): 저장소 루트가 곧 패키지 루트다. 로컬 패키지
    ("file:../../ked-progression")로 물리면 유니티는 .gitignore 를 보지 않고 이 폴더까지
    임포트한다 — NuGet 이 받아 둔 nunit.framework.dll 이 com.unity.test-framework 의
    NUnit 과 충돌해 오류 79개가 났다. 유니티는 점으로 시작하는 이름을 아예 무시하므로
    이름 하나로 그 경로가 닫힌다.
  -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory).artifacts</ArtifactsPath>
  </PropertyGroup>

  <!--
    NuGet 복원 산출물은 UseArtifactsOutput 이 옮기지 않는다 — project.assets.json ·
    *.nuget.g.props 는 프로젝트 옆 obj/ 에 그대로 남는다. 위 주석이 경고한 그 자리가
    실제로 이 경로였다(2026-08-23 실측: Runtime/obj · Tests/obj 가 유니티에 임포트됐다).
    복원 경로도 같이 몬다.
  -->
  <PropertyGroup>
    <MSBuildProjectExtensionsPath>$(MSBuildThisFileDirectory).artifacts/obj/$(MSBuildProjectName)/</MSBuildProjectExtensionsPath>
  </PropertyGroup>

</Project>
